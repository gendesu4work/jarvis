#!/usr/bin/env python3
"""Run a PowerShell command on the user's Windows PC - ONLY while FULL ACCESS is unlocked.

  winrun "Get-ChildItem $HOME\\Desktop"
  winrun --timeout 300 "<long command>"
  winrun --status            is full access on, and for how long

Locked? It says so - ask the user for their access code ("Jarvis, access code ...").
Catastrophic commands (disk wipes, deleting Windows, boot/security settings) still ask the user.
"""
import json, socket, sys

def call(cmd):
    try:
        s = socket.create_connection(("127.0.0.1", 9334), timeout=20)
    except OSError:
        return {"ok": False, "error": "Jarvis app is not running on Windows."}
    s.sendall(json.dumps(cmd).encode() + b"\n")
    buf = b""; s.settimeout(700)
    try:
        while not buf.endswith(b"\n"):
            d = s.recv(65536)
            if not d: break
            buf += d
    except OSError:
        pass
    return json.loads(buf or b'{"ok": false, "error": "no reply"}')

a = sys.argv[1:]
if not a or a[0] in ("-h", "--help"):
    print(__doc__); sys.exit(0)
if a[0] == "--status":
    r = call({"action": "access_status"})
    print(f"Full access: {'ON, ' + str(r.get('seconds_left', 0) // 60) + ' min left' if r.get('full_access') else 'locked'}")
    sys.exit(0)
timeout = None
if a[0] == "--timeout" and len(a) > 2:
    timeout, a = int(a[1]), a[2:]
r = call({"action": "win_exec", "command": " ".join(a), "timeout": timeout})
if r.get("output"): print(r["output"], end="")
if r.get("errors"): print(r["errors"], end="", file=sys.stderr)
if r.get("error"): print("ERROR:", r["error"], file=sys.stderr)
sys.exit(0 if r.get("ok") else 1)
